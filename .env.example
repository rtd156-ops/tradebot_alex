# Copia este archivo a .env y llena tus credenciales.
# NUNCA subas el archivo .env al repositorio.

# --- Bybit (solo necesario en modo live) ---
BYBIT_API_KEY=
BYBIT_API_SECRET=
# true = usar testnet de Bybit (recomendado antes de pasar a real)
BYBIT_TESTNET=true

# --- Telegram (opcional, para recibir alertas de operaciones) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Webhook (opcional, ej. tu agente de OpenClaw) ---
# El bot manda POST con JSON estructurado (event, symbol, side, qty, price,
# entry, exit, pnl, strategy, timestamp, exchange, text) en cada operación/señal.
# WEBHOOK_TOKEN se envía en los headers "X-Webhook-Secret" y "Authorization: Bearer".
# Prueba la conexión con: python scripts/test_webhook.py
WEBHOOK_URL=
WEBHOOK_TOKEN=
