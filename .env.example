# Copia este archivo a .env y llena tus credenciales.
# NUNCA subas el archivo .env al repositorio.

# --- Bybit (solo necesario en modo live) ---
BYBIT_API_KEY=
BYBIT_API_SECRET=
# true = usar testnet de Bybit (recomendado antes de pasar a real)
BYBIT_TESTNET=true

# --- Telegram (opcional, para recibir alertas de operaciones) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Webhook (opcional, ej. tu agente de OpenClaw) ---
# El bot manda POST JSON {"text": "<mensaje>"} a esta URL en cada operación/señal.
# Si defines WEBHOOK_TOKEN se envía como "Authorization: Bearer <token>".
WEBHOOK_URL=
WEBHOOK_TOKEN=
